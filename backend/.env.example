# ===== Back-end (Spring Boot) - Variaveis de Ambiente =====
# Copie este arquivo para ".env" e preencha com os valores reais.

# Porta do servidor
SERVER_PORT=8080

# ===== Conexao com o Supabase (PostgreSQL) =====
# No painel do Supabase: Project Settings > Database > Connection string (JDBC)
# Exemplo de host: db.<project-ref>.supabase.co  (porta 5432)
SPRING_DATASOURCE_URL=jdbc:postgresql://db.SEU_PROJETO.supabase.co:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=sua-senha-do-banco

# ===== JWT =====
# Use uma chave longa (>= 32 bytes) para HS256
JWT_SECRET=troque-esta-chave-por-uma-chave-secreta-bem-longa-para-hs256

# ===== CORS =====
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
